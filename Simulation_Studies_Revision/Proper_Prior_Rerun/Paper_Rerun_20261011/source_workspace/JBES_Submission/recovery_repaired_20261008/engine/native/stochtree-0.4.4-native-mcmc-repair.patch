+  double total_weight = std::accumulate(variable_weights.begin(), variable_weights.end(), 0.0);
+  if (!(total_weight > 0.0)) return -std::numeric_limits<double>::infinity();
+  return std::log(variable_weights[feature_index]) - std::log(total_weight) - std::log(range_width);
