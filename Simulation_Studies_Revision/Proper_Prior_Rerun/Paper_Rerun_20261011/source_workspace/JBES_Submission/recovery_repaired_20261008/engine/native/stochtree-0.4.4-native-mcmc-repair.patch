+static inline bool AnyLeafCanGrowAfterGrow(Tree* tree, ForestTracker& tracker, ForestDataset& dataset,
+                                           TreePrior& tree_prior, const std::vector<double>& variable_weights,
+                                           int tree_num, int split_leaf, int split_feature,
+                                           TreeSplit& split, int child_depth) {
+  if (AnyLeafCanGrow(tree, tracker, dataset, tree_prior, variable_weights, tree_num, split_leaf)) return true;
+  int32_t max_depth = tree_prior.GetMaxDepth();
+  if ((max_depth != -1) && (child_depth >= max_depth)) return false;
+  std::vector<data_size_t> parent_samples = NodeSampleIndices(tracker, tree_num, split_leaf);
+  std::vector<data_size_t> left_samples;
+  std::vector<data_size_t> right_samples;
+  left_samples.reserve(parent_samples.size());
+  right_samples.reserve(parent_samples.size());
+  for (data_size_t sample_id : parent_samples) {
+    if (split.SplitTrue(dataset.CovariateValue(sample_id, split_feature))) left_samples.push_back(sample_id);
+    else right_samples.push_back(sample_id);
+  }
+  return HasPositiveMeasureNumericGrow(left_samples, dataset, variable_weights, tree_prior.GetMinSamplesLeaf()) ||
