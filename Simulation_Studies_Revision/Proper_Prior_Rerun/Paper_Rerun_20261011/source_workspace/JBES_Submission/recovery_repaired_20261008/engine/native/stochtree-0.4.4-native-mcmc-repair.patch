+static inline double LogGrowRuleDensity(const std::vector<double>& variable_weights,
+                                        int feature_index, double range_width) {
+  if (!(range_width > 0.0) || feature_index < 0 ||
+      feature_index >= static_cast<int>(variable_weights.size()) ||
+      !(variable_weights[feature_index] > 0.0)) {
+    return -std::numeric_limits<double>::infinity();
